{% extends 'base.html.twig' %}

{% block title %}{{ tittle }}{% endblock %}

{% block body %}

    <form id="search-form" class="mb-4">
        <input
                type="text"
                id="search-query"
                name="query"
                placeholder="Rechercher..."
                class="border p-2 rounded w-full"
        />
        <button
                type="submit"
                class="bg-blue-500 text-white p-2 rounded mt-2 w-full">
            Rechercher
        </button>
    </form>

    <div id="results" class="grid grid-cols-3 gap-4">
        {% for card in cards %}
            <div class="bg-white p-4 border border-gray-200 rounded-lg shadow-md">
                <p class="text-center text-lg font-semibold">{{ card.username }}</p>
            </div>
        {% endfor %}
    </div>

    <script>
        document.getElementById('search-form').addEventListener('submit', function(e) {
            e.preventDefault();

            // Récupération de la valeur de recherche
            const query = document.getElementById('search-query').value;

            // Envoi de la requête via fetch
            fetch("{{ path('search') }}", {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                },
                body: JSON.stringify({ query: query })
            })
                .then(response => response.json())
                .then(data => {
                    // Mise à jour des résultats
                    const resultsDiv = document.getElementById('results');
                    resultsDiv.innerHTML = ''; // Réinitialiser le contenu des résultats

                    data.cards.forEach(card => {
                        const cardDiv = document.createElement('div');
                        cardDiv.classList.add('bg-white', 'p-4', 'border', 'border-gray-200', 'rounded-lg', 'shadow-md');
                        cardDiv.innerHTML = `<p class="text-center text-lg font-semibold">${card.username}</p>`;
                        resultsDiv.appendChild(cardDiv);
                    });
                })
                .catch(error => console.error('Erreur lors de la recherche:', error));
        });
    </script>

{% endblock %}
