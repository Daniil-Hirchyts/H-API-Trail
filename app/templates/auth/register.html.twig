{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
    <main>
        {{ form_start(form, {'attr': {'class': 'center basic-form'}}) }}
        <fieldset>
            <legend>Inscription</legend>
            <div class="access-container">
                {{ form_label(form.username) }}
                <p class="help-input-form">Entre 4 et 20 caractères</p>
                {{ form_widget(form.username) }}
            </div>
            <div class="access-container">
                {{ form_label(form.password) }}
                <p class="help-input-form">Entre 8 et 30 caractères, au moins une minuscule, une majuscule et un
                    nombre</p>
                {{ form_widget(form.password) }}
            </div>
            <div class="access-container">
                {{ form_label(form.email) }}
                {{ form_widget(form.email) }}
            </div>
            <div class="access-container">
                {{ form_label(form.visible) }}
                {{ form_widget(form.visible) }}
            </div>
            {{ form_widget(form.register, {'id' : 'inscription-submit', 'attr': {'class': 'basic-form-submit'}}) }}
        </fieldset>
        {{ form_rest(form) }}
        {{ form_end(form) }}
    </main>
{% endblock %}
