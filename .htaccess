<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /~garroc/front/

  # Si le fichier ou le dossier existe, le servir normalement
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Sinon, rediriger toutes les requêtes vers index.html
  RewriteRule . /~garroc/front/index.html [L]
</IfModule>